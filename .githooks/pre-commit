#!/usr/bin/env bash
# Hook de pre-commit de Velvet Heist '84. Se activa una vez por clon:
#   git config core.hooksPath .githooks
# Ejecuta las comprobaciones rápidas sobre lo preparado para commit. Las que necesitan Godot
# (importación, compilación, tests) se ejecutan con /verify y en CI.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
export STAGED=1

./tools/ci/lint.sh
./tools/ci/check_patterns.sh
python3 tools/ci/check_scope.py --staged
