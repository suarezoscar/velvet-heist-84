# Configuración de tools/agy/dispatch.sh (Antigravity CLI en modo headless).
# Se lee con `source`: sintaxis de bash.

# Slug del modelo rápido (Gemini Flash) tal como lo lista `agy models`. Obligatorio.
AGY_MODEL="gemini-3.8-flash-high"

# Tiempo máximo de una ejecución de agy (por defecto agy corta a los 5m).
AGY_TIMEOUT="60m"

# Flags extra. Sin --sandbox: el sandbox de agy monta el worktree en solo lectura para los
# comandos (decisión del 2026-10-22). Los permisos son la lista allow/deny de
# ~/.gemini/antigravity-cli/settings.json; en headless se deniega todo lo que no esté en allow.
# Este proyecto no usa --dangerously-skip-permissions.
AGY_EXTRA_FLAGS=""

# 1: se pasa --agent <agente> (requiere que `agy agents` liste los agentes de .agents/agents/).
# 0: el agente se indica en el prompt, para versiones de agy que no reconozcan ese formato.
AGY_USE_AGENT_FLAG=0

# Carpeta de los worktrees de paquetes. Por defecto, junto al repositorio: ../<repo>-worktrees
AGY_WORKTREES=""

# Ejecutor por defecto: agy u opencode. Se puede cambiar por llamada con --executor.
EXECUTOR="agy"

# opencode: modelo (provider/modelo, mira 'opencode models') y tiempo máximo por ejecución.
# Los permisos están en tools/agy/opencode.json (se pasa con OPENCODE_CONFIG).
OPENCODE_MODEL="opencode-go/deepseek-v4.1-flash"
OPENCODE_TIMEOUT="60m"
