{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "question": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git rm *": "allow",
      "git update-index --chmod=+x *": "allow",
      "git commit *": "allow",
      "./tools/ci/import.sh*": "allow",
      "./tools/ci/check_scripts.sh*": "allow",
      "./tools/ci/lint.sh*": "allow",
      "./tools/ci/check_patterns.sh*": "allow",
      "./tools/ci/run_tests.sh*": "allow",
      "./tools/ci/run_blender_tests.sh*": "allow",
      "./tools/ci/scan_godot_log.sh*": "allow",
      "./tools/ci/qa_scan_godot_log.sh*": "allow",
      "./tools/ci/qa_validate_all.sh*": "allow",
      "python3 tools/ci/check_scope.py*": "allow",
      "./tools/net/run_server.sh*": "allow",
      "timeout ?? ./tools/net/run_server.sh*": "allow",
      "timeout ?? godot --headless --path . -- --server*": "allow",
      "gdlint *": "allow",
      "gdformat *": "allow",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "find *": "allow",
      "find *-exec*": "deny",
      "find *-delete*": "deny",
      "find *-fprint*": "deny",
      "find *-fls*": "deny",
      "find *-ok*": "deny",
      "git commit* -n*": "deny",
      "git commit* -?n*": "deny",
      "git commit* -??n*": "deny",
      "git commit*--no-veri*": "deny",
      "git *--output*": "deny",
      "*..*": "deny",
      "* /*": "deny",
      "*\t*": "deny",
      "* ~*": "deny",
      "*=/*": "deny",
      "*=~*": "deny",
      "*-?/*": "deny",
      "*\"/*": "deny",
      "*'/*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*$*": "deny",
      "*`*": "deny",
      "*{*": "deny",
      "*;*": "deny",
      "*&*": "deny",
      "*|*": "deny"
    }
  }
}
