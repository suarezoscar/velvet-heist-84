{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "question": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "deny",
      "git *": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git *--no-verify*": "deny",
      "git config*": "deny",
      "./tools/ci/*": "allow",
      "python3 tools/ci/*": "allow",
      "godot *": "allow",
      "gdlint *": "allow",
      "gdformat *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "find *": "allow",
      "find *-exec*": "deny",
      "find *-delete*": "deny",
      "mkdir -p *": "allow",
      "touch *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "which *": "allow",
      "chmod +x *": "allow"
    }
  }
}
